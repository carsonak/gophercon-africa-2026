package pages

import (
	"fmt"
	"workshop/web/views/layout"
)

templ Home(data OrbitPage) {
	@layout.Base(layout.BaseProps{Title: "Wild Orbit — A little closer to the wild"}) {
		<header class="site-header">
			<a class="brand" href="/" aria-label="Wild Orbit home"><img src="/assets/images/logo.svg" width="38" height="38" alt=""/><span>WILD<span class="brand-light">ORBIT</span><span class="brand-dot" aria-hidden="true">✦</span></span></a>
			<span class="header-note"><span class="live-dot"></span>A FIELD GUIDE TO EVERYWHERE</span>
			<button class="location-trigger enhanced" id="location-trigger" hidden><span aria-hidden="true">⌖</span> Your coordinates <span class="tiny-arrow" aria-hidden="true">↗</span></button>
		</header>
		<main id="explore">
			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow"><span></span> THE WORLD IS STILL WILD</p>
				<h1 id="page-title">A little closer<br/>to <em>the wild.</em></h1>
				<p class="intro-copy">Extraordinary lives. Unexpected places.<br/>Follow your curiosity around the planet.</p>
			</section>
			<section class="observatory" id="observatory" aria-label="Explore wildlife sightings">
				<div class="globe-backdrop" aria-hidden="true">
					<svg class="globe-fallback" viewBox="0 0 800 800"><defs><radialGradient id="halo"><stop stop-color="#be9250" stop-opacity=".07"></stop><stop offset="1" stop-color="#be9250" stop-opacity="0"></stop></radialGradient></defs><circle cx="400" cy="400" r="395" fill="url(#halo)"></circle><g fill="none" stroke="#b18b4c" stroke-width=".65"><circle cx="400" cy="400" r="326"></circle><ellipse cx="400" cy="400" rx="245" ry="326"></ellipse><ellipse cx="400" cy="400" rx="130" ry="326"></ellipse><ellipse cx="400" cy="400" rx="30" ry="326"></ellipse><ellipse cx="400" cy="400" rx="326" ry="65"></ellipse><ellipse cx="400" cy="400" rx="326" ry="170"></ellipse><ellipse cx="400" cy="400" rx="326" ry="260"></ellipse><path d="M74 400h652M400 74v652"></path></g></svg>
					<canvas id="globe"></canvas>
					<div class="globe-axis axis-top">90° N</div>
					<div class="globe-axis axis-bottom">90° S</div>
				</div>
				<div class="context-bar">
					<div><span class="live-dot"></span><h2 id="context-label">A window into the world</h2></div>
					<button id="layout-toggle" class="layout-toggle enhanced" aria-pressed="false" hidden><span aria-hidden="true">▦</span> Grid</button>
				</div>
				<div class="photo-stage" id="photo-stage">
					<div class="photo-list" id="photo-list">
						for i, r := range data.Initial {
							<article class={ fmt.Sprintf("photo-slot slot-%d", i) }>
								<a class="photo-card" href={ templ.URL(r.Photo.URL) } data-id={ r.ID }>
									<div class="image-wrap"><img src={ r.Photo.Thumb } alt={ r.Name + " — " + r.Place } loading="lazy"/></div>
									<div class="photo-caption"><span>{ r.Name }</span><span class="photo-arrow" aria-hidden="true">↗</span><small>{ r.Country }</small></div>
									<span class="observer">{ r.Observer }</span>
								</a>
							</article>
						}
						if len(data.Records) == 0 {
							<p class="empty-state">No photographs in this orbit yet. Import sightings using the workshop CLI to begin exploring.</p>
						}
					</div>
				</div>
				<nav class="discovery enhanced" aria-label="Choose your next discovery" hidden>
					<button class="journey journey-world" data-mode="world"><span class="button-icon" aria-hidden="true">↗</span><span>Across the world<small>A change of coordinates</small></span></button>
					<button class="journey journey-climate" data-mode="climate"><span class="button-icon" aria-hidden="true">☼</span><span>Different climate<small>Find another kind of warmth</small></span></button>
					<button class="journey journey-water" data-mode="water"><span class="button-icon waves" aria-hidden="true">≈</span><span>On the water<small>Life beyond the shoreline</small></span></button>
					<button class="journey journey-different" data-mode="different"><span class="button-icon" aria-hidden="true">✳</span><span>Something different<small>Let curiosity take the lead</small></span></button>
					<button class="near-button" id="near-me" data-mode="near" hidden><span aria-hidden="true">⌖</span> Near me</button>
				</nav>
				<div class="results-footer">
					<p id="result-status" role="status" aria-live="polite" aria-atomic="true">Six glimpses of a much bigger world.</p>
					<button class="show-more" id="show-more" hidden>Show more sightings <span aria-hidden="true">↓</span></button>
					<span class="stack-hint" id="stack-hint">HOVER TO SHUFFLE · CLICK TO EXPLORE</span>
				</div>
			</section>
			<section class="location-panel" id="location-panel" aria-labelledby="location-title" hidden>
				<div><p class="eyebrow">YOUR STARTING POINT</p><h2 id="location-title">Where does your orbit begin?</h2><p id="location-message">Share your location to find the nearest recorded wildlife, or choose a country. Your coordinates stay in your browser.</p></div>
				<div class="location-actions">
					<label for="country">Choose a country</label>
					<select id="country">
						<option value="">Select a country</option>
						for _, c := range data.Countries {
							<option value={ c.Code }>{ c.Name }</option>
						}
					</select><button id="retry-location">Use my location <span aria-hidden="true">↗</span></button><button id="close-location" class="text-button">Close</button>
				</div>
			</section>
			<div class="bottom-note"><span class="note-line"></span><span>NO TWO JOURNEYS ARE THE SAME</span><span class="note-line"></span></div>
		</main>
		<footer class="site-footer"><p>A whole planet. <span>One shared home.</span></p><div class="dataset-info"><span>{ fmt.Sprint(data.Total) } OBSERVATIONS</span><span>{ fmt.Sprint(data.Species) } SPECIES</span></div><div class="footer-links"><a href="https://www.gbif.org/" target="_blank" rel="noopener noreferrer">Data: GBIF ↗</a><a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Weather: Open-Meteo ↗</a><button class="text-button enhanced" id="motion-toggle" aria-pressed="false" hidden>Pause dust</button></div></footer>
		<dialog id="sighting-dialog" aria-labelledby="sighting-title"><button class="dialog-close" id="dialog-close" aria-label="Close sighting">×</button><div id="sighting-content"></div><section class="similar-section" aria-labelledby="similar-title"><div class="similar-heading"><h3 id="similar-title">Same species. Other stories.</h3><div><button id="similar-prev" aria-label="Previous similar sightings">←</button><button id="similar-next" aria-label="Next similar sightings">→</button></div></div><div class="similar-list" id="similar-list"></div></section></dialog>
		@templ.JSONScript("orbit-data", data)
	}
}
